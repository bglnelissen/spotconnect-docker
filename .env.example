# Copy this file to .env next to compose.yml and fill it in.
# docker compose reads .env by itself. .env is not tracked by git.

# LAN address of the Docker host. spotraop binds to it, the web page listens on it.
HOST_IP=192.168.1.10

# How you reach the Docker host with ssh from your own computer. The web page only
# uses this to build the commands it shows; it never connects anywhere.
SSH_TARGET=user@docker-host

# Where this repository lives on the Docker host, as seen from that ssh login.
REMOTE_DIR=~/spotconnect

# Port of the web page.
WEB_PORT=8131
